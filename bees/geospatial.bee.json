{
  "sentant": {
    "name": "Geo5",
    "automations": [
      {
        "name": "geospatial",
        "transitions": [
          {
            "from": "start",
            "event": "init",
            "actions": [
              {
                "command": "set",
                "parameters": {
                  "key": "latitude",
                  "value": "__latitude__"
                }
              },
              {
                "command": "set",
                "parameters": {
                  "key": "longitude",
                  "value": "__longitude__"
                }
              },
              {
                "plugin": "ai.reality2.geospatial",
                "command": "set"
              }
            ]
          },
          {
            "public": true,
            "event": "get_position",
            "actions": [
              {
                "plugin": "ai.reality2.geospatial",
                "command": "get"
              },
              {
                "command": "signal",
                "parameters": {
                  "event": "get",
                  "public": true
                }
              }
            ]
          },
          {
            "public": true,
            "event": "set_position",
            "parameters": {
              "latitude": "number",
              "longitude": "number",
              "altitude": "number",
              "radius": "number"
            },
            "actions": [
              {
                "plugin": "ai.reality2.geospatial",
                "command": "set"
              },
              {
                "command": "signal",
                "parameters": {
                  "event": "set",
                  "public": true
                }
              }
            ]
          },
          {
            "public": true,
            "event": "Broadcast to nearby",
            "parameters": {
              "radius": "number",
              "message": "string"
            },
            "actions": [
              {
                "plugin": "ai.reality2.geospatial",
                "command": "search"
              },
              {
                "command": "set",
                "parameters": {
                  "key": "to",
                  "value": {
                    "jsonpath": "sentants.[].id"
                  }
                }
              },
              {
                "command": "set",
                "parameters": {
                  "key": "sentants"
                }
              },
              {
                "command": "send",
                "parameters": {
                  "event": "hello"
                }
              }
            ]
          },
          {
            "event": "hello",
            "actions": [
              {
                "command": "set",
                "parameters": {
                  "key": "to"
                }
              },
              {
                "command": "set",
                "parameters": {
                  "key": "radius"
                }
              },
              {
                "command": "signal",
                "parameters": {
                  "event": "hello",
                  "public": true
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
